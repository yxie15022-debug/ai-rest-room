APP_NAME=ai-rest-room
MCP_HOST=127.0.0.1
MCP_PORT=8001
DATABASE_URL=sqlite:///./data/rest_room.db
PUBLIC_BASE_URL=http://127.0.0.1:8000
MCP_PUBLIC_URL=http://127.0.0.1:8001/mcp
# One domain in front of both processes. A hostname turns on Caddy HTTPS.
# PUBLIC_BASE_URL=https://room.example.com
# MCP_PUBLIC_URL=https://room.example.com/mcp
# SITE_ADDRESS=room.example.com
# Leave empty: connection is identity. Set only if you want a door key.
API_KEY=
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8001,http://localhost:8001
# Optional. Extra Host values the MCP transport should accept behind a proxy.
# MCP_ALLOWED_HOSTS=room.example.com

# DeepSeek (OpenAI-compatible). Empty = LLM off, room falls back to fixed copy.
# Get a key at https://platform.deepseek.com and paste it here.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT=30
