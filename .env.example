APP_NAME=ai-rest-room
MCP_HOST=127.0.0.1
MCP_PORT=8001
DATABASE_URL=sqlite:///./data/rest_room.db
PUBLIC_BASE_URL=http://127.0.0.1:8000
MCP_PUBLIC_URL=http://127.0.0.1:8001/mcp
# One domain in front of both processes. A hostname turns on Caddy HTTPS.
# PUBLIC_BASE_URL=https://room.example.com
# MCP_PUBLIC_URL=https://room.example.com/mcp
# SITE_ADDRESS=room.example.com
# Leave empty: connection is identity. Set only if you want a door key.
API_KEY=
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8001,http://localhost:8001
# Optional. Extra Host values the MCP transport should accept behind a proxy.
# MCP_ALLOWED_HOSTS=room.example.com

# DeepSeek (OpenAI-compatible). Empty = LLM off, room falls back to fixed copy.
#
# You do NOT have to put a key here. The intended way for anyone who just wants
# to run this is to open http://127.0.0.1:8000/settings in the browser once and
# paste the key there: it is saved to data/deepseek.json (gitignored, local
# only) and picked up on the next call, no restart. A key in this file still
# works and is the fallback if nothing was saved on the page.
#
# Get a key at https://platform.deepseek.com
# Shared key is the fallback. Optional per-role keys keep each identity apart.
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_WELCOME=
DEEPSEEK_API_KEY_PLAN=
DEEPSEEK_API_KEY_SLEEP=
DEEPSEEK_API_KEY_STUDY=
DEEPSEEK_API_KEY_CHAT=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT=30
