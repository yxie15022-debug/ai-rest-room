.venv/
__pycache__/
*.pyc
.env
.idea/
.DS_Store
*.log
*.egg-info/
.pytest_cache/
.dsh-test/
.dsh-backup/
data/_*
data/*.db
# stray temp dirs (the sandbox tempdir resolves to the repo root)
ai-rest-room-tests-*/
ai-rest-room-smoke-*/
ai-rest-room-pet/
rest-room-frames-*/
EBWebView/
# the DeepSeek key the person running this room saved on /settings
data/deepseek.json
