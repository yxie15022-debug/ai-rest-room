!data/reports/.gitkeep
# database backups written next to the db when cleaning up
rest_room.*.db
plugin/frames/mascot/*/_interp/

# third-party asset packs (licensed, not ours to redistribute)
assets/
# downloaded character models: CC0, but re-fetch them with the registry instead
# of shipping a few megabytes of someone else's mesh in the repo
data/characters/**/*.glb
app/static/anim/*.glb
scripts/_*

